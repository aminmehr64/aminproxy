{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aminproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "441ba915-4d95-43e6-9144-b678185c676b","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "35e91ae4683341018d80c10eb9c1877a" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
